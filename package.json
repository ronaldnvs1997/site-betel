{
  "name": "sistema-betel",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema da Igreja Batista Betel — site, Área de Membros e Agenda Ministerial (Supabase + Render Static Site)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "bash scripts/construir-site.sh",
    "config": "node scripts/gerar-config.mjs",
    "dev": "node scripts/gerar-config.mjs && node scripts/servir-local.mjs",
    "masters": "node --env-file=.env scripts/criar-primeiros-masters.mjs",
    "verificar": "node scripts/verificar.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2"
  },
  "devDependencies": {
    "jspdf": "2.5.1",
    "tailwindcss": "3.4.19"
  }
}
