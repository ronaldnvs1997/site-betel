# Copie para .env (que NÃO vai para o GitHub) e preencha. No Render, estas variáveis
# são cadastradas no painel do serviço (Environment) — nunca no código.

# Banco PostgreSQL (obrigatório). Ex. local: postgres://usuario:senha@localhost:5432/betel
DATABASE_URL=
# "true" só para conexão externa com SSL (o endereço interno do Render não precisa)
DATABASE_SSL=

# Segredo das sessões, 32+ caracteres aleatórios (obrigatório). No Render o render.yaml gera sozinho.
JWT_SECRET=

# Porta local (o Render define a dele)
PORT=8095

# Endereço público do site, ex.: https://betelflamengo.com.br (opcional)
PUBLIC_URL=

# Primeiros administradores, só na primeira instalação: Nome|email|telefone;Nome|email|telefone
BETEL_MASTERS=

# E-mail para "Esqueci minha senha" (opcional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
