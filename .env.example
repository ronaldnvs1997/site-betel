# ---------------------------------------------------------------
# Sistema Betel — variáveis de ambiente (copie para .env e preencha)
# O .env está no .gitignore e NUNCA vai para o GitHub.
# Os valores ficam em: Supabase → Project Settings → API
# ---------------------------------------------------------------

# Endereço do projeto Supabase (ex.: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave PÚBLICA (anon / publishable). Vai para o navegador em site/config.js — é o esperado:
# o que ela pode fazer é limitado pelas políticas RLS do banco.
SUPABASE_ANON_KEY=

# Chave de SERVIÇO (service_role / secret). Só no seu computador, só para:
#   npm run masters   (criar os primeiros administradores, uma única vez)
# NÃO coloque no Render, no site nem no GitHub. As Edge Functions já recebem
# essa chave do próprio Supabase, sem configuração.
SUPABASE_SERVICE_ROLE_KEY=
